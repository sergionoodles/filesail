#!/usr/bin/env bash
set -euo pipefail

filesail_data_dir=@FILESAIL_INSTALL_DATADIR_SHELL@/filesail
filesail_backend_default=@FILESAIL_INSTALL_BINDIR_SHELL@/filesail-backend

if [[ ! -x "${FILESAIL_BACKEND:-$filesail_backend_default}" ]]; then
    printf 'FileSail backend not found. Expected: %s\n' "${FILESAIL_BACKEND:-$filesail_backend_default}" >&2
    exit 1
fi

export FILESAIL_BACKEND="${FILESAIL_BACKEND:-$filesail_backend_default}"
requested_path="${FILESAIL_PATH:-$HOME}"
while (($#)); do
    case "$1" in
        --path)
            [[ $# -ge 2 ]] || { printf '%s\n' 'filesail: --path requires a directory' >&2; exit 2; }
            requested_path="$2"
            shift 2
            ;;
        --path=*)
            requested_path="${1#--path=}"
            shift
            ;;
        --help|-h)
            printf '%s\n' 'Usage: filesail [--path PATH] [PATH]' \
                'Environment: FILESAIL_LOG=error|warn|info|debug (default: info)'
            exit 0
            ;;
        -*)
            printf 'filesail: unknown option: %s\\n' "$1" >&2
            exit 2
            ;;
        *)
            requested_path="$1"
            shift
            ;;
    esac
done
export FILESAIL_PATH="$requested_path"
export QS_APP_ID="dev.filesail.FileSail"

qs_args=(--allow-duplicate -p "$filesail_data_dir")
case "${FILESAIL_LOG:-info}" in
    debug) qs_args+=(--log-rules "qml.debug=true;qml.info=true") ;;
    info) qs_args+=(--log-rules "qml.info=true") ;;
esac

exec qs "${qs_args[@]}"
