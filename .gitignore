# CMake build trees (the documented build directory and in-source builds)
/build/
/CMakeCache.txt
/CMakeFiles/
/CMakeScripts/
/Testing/
/CTestTestfile.cmake
/DartConfiguration.tcl
/cmake_install.cmake
/install_manifest.txt
/Makefile
/_deps/
/*.cmake.user

# Arch makepkg working directories and package archives
/dist/
/pkg/
# Legacy source mirrors created before makepkg was configured to use ./dist.
/filesail/
/filesail-checkout/
/src/filesail-checkout/
# Keep checkouts created by older PKGBUILD revisions ignored.
/src/filesail/
/src/filesail-build/
/*.pkg.tar.*
/integrations/noctalia/pkg/
/integrations/noctalia/src/
/integrations/noctalia/*.pkg.tar.*

# Generated Qt/CMake artifacts and the local backend executable
/.qt/
/*_autogen/
/filesail-backend
/*.qmlc

# Coverage and profiling output
/coverage/
/coverage-html/
*.gcda
*.gcno
*.profraw
*.profdata

# Local editor and operating-system files
.idea/
.vscode/
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db
