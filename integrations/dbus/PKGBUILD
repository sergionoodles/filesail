pkgname=filesail-dbus
pkgver="$(bash "$startdir/../../scripts/read-version.sh")"
pkgrel=1
pkgdesc='Optional org.freedesktop.FileManager1 integration for FileSail'
arch=('x86_64')
url='https://github.com/sergionoodles/filesail'
license=('MIT')
depends=('filesail')
makedepends=('cmake' 'git' 'pkgconf')
source=('filesail::git+https://github.com/sergionoodles/filesail.git#branch=main')
sha256sums=('SKIP')

BUILDDIR="$startdir/dist"
SRCDEST="$BUILDDIR"
PKGDEST="$BUILDDIR"
SRCPKGDEST="$BUILDDIR"
LOGDEST="$BUILDDIR"

build() {
    cmake -S "$srcdir/filesail" -B "$srcdir/filesail-dbus-build" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DFILESAIL_BUILD_DBUS=ON
    cmake --build "$srcdir/filesail-dbus-build" --parallel
}

check() {
    ctest --test-dir "$srcdir/filesail-dbus-build" --output-on-failure
}

package() {
    # Install only this package's files explicitly. A full `cmake --install`
    # would also stage binaries owned by the main filesail package.
    install -Dm755 -- "$srcdir/filesail-dbus-build/filesail-filemanager1" \
        "$pkgdir/usr/bin/filesail-filemanager1"
    install -Dm644 -- "$srcdir/filesail/packaging/filesail-filemanager1.service" \
        "$pkgdir/usr/lib/systemd/user/filesail-filemanager1.service"
}
