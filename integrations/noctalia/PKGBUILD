pkgname=filesail-noctalia
pkgver="$(bash "$startdir/../../scripts/read-version.sh")"
pkgrel=1
pkgdesc='Noctalia 5 native panel and bar integration for FileSail'
arch=('x86_64')
url='https://github.com/sergionoodles/filesail'
license=('MIT')
depends=('filesail' 'noctalia' 'bash' 'findutils' 'coreutils')
makedepends=('git')
# This follows main until the first release tag exists. Pin this to a release
# tag or commit before publishing a stable AUR revision.
source=('filesail::git+https://github.com/sergionoodles/filesail.git#branch=main')
sha256sums=('SKIP')

package() {
    local plugin_root="$pkgdir/usr/share/filesail/noctalia-plugin"
    local manifest="$srcdir/filesail-generated/plugin.toml"
    "$srcdir/filesail/scripts/generate-noctalia-plugin.sh" "$manifest"
    install -d "$plugin_root"

    install -Dm644 "$manifest" \
        "$plugin_root/plugin.toml"
    install -Dm644 "$srcdir/filesail/integrations/noctalia/widget.luau" \
        "$plugin_root/widget.luau"
    install -Dm644 "$srcdir/filesail/integrations/noctalia/panel.luau" \
        "$plugin_root/panel.luau"
    install -Dm755 "$srcdir/filesail/integrations/noctalia/list-directory.sh" \
        "$plugin_root/list-directory.sh"

    install -Dm755 "$srcdir/filesail/scripts/install-noctalia-package.sh" \
        "$pkgdir/usr/bin/filesail-noctalia-install"
}
